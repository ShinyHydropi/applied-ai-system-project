flowchart TD
    subgraph INPUT["Input"]
        CSV1[data/songs.csv]
        CSV2[data/ai_songs.csv]
        TEXT["Free-text taste description\n(regression_suggestions.py CLI prompt)"]
    end

    CSV1 --> LOAD["load_songs()"]
    CSV2 --> LOAD
    LOAD --> SCORE

    subgraph PARSE["Agent: structured-prompting parser"]
        SANITIZE0["sanitize()\nprompt-injection guard"]
        PARSEFN["parse_preferences()\nGemini call, JSON-schema output"]
        PTRUST{"Evaluator:\ntrustworthy?"}
        TEXT --> SANITIZE0 --> PARSEFN --> PTRUST
        PTRUST -- "no / error /\nempty description" --> DEFAULT["UserProfile()\nconfidence = None"]
        PTRUST -- "yes" --> PARSEDPROF["Parsed UserProfile\n+ self-reported confidence"]
    end

    subgraph PROCESS["Retriever + Ranker"]
        SCORE["score_song()\nrule-based retriever"]
        RANK["recommend_songs()\nrank all songs, keep top-k"]
        SCORE --> RANK
        RANK --> SANITIZE1["sanitize()\nprompt-injection guard"]
        SANITIZE1 --> LLM["generate_explanation()\nGemini agent call"]
        LLM --> TRUST{"Evaluator:\ntrustworthy?"}
        TRUST -- "no" --> TEMPLATE["Template explanation\n'; '.join(reasons)"]
        TRUST -- "yes" --> CAP["enforce length cap"]
    end

    DEFAULT --> SCORE
    PARSEDPROF --> SCORE
    TEMPLATE --> OUT
    CAP --> OUT

    OUT["Output:\nprints generated profile, confidence %,\nand top 10 recommendations"]

    subgraph CHECK["Human / Testing checkpoints"]
        CONF["Confidence % printed to the user"]
        FALLBACK["gemini_client.py fallback design"]
    end

    PARSEDPROF --> CONF
    FALLBACK -.guards.-> LLM
    FALLBACK -.guards.-> PARSEFN